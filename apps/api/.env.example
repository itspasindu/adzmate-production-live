# AdzMate API — production-oriented configuration
# Copy to apps/api/.env and fill in values.

# --- Environment ---
ENVIRONMENT=development
# production | staging | development

# --- Database (Supabase Postgres recommended for production) ---
# Supabase → Project Settings → Database → Connection string (URI)
# Use the "Transaction pooler" URL on port 6543 for serverless hosts (Render).
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./adzmate.db

# --- Auth (Supabase) ---
AUTH_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
# Legacy HS256 secret OR leave empty when using ES256 + JWKS via SUPABASE_URL
ADZMATE_ALLOW_DEMO=1
# Set 0 in production. Allows local-demo user when Supabase is not configured (dev only).

# --- Redis (Upstash) ---
REDIS_URL=
# Example: rediss://default:password@us1-xxx.upstash.io:6379

# --- Object storage (Cloudflare R2) ---
STORAGE_BACKEND=local
# local | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adzmate-assets
R2_PUBLIC_URL=https://assets.yourdomain.com
# Custom domain or R2.dev public URL
R2_ENDPOINT=
# Optional: https://<account_id>.r2.cloudflarestorage.com

# --- Token encryption (Meta OAuth tokens at rest) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- URLs ---
PUBLIC_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI agents (Gemini recommended) ---
ADZMATE_USE_LLM=1
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

ADZMATE_USE_AI_IMAGES=1
# ADZMATE_USE_DISTILBERT=1
# ADZMATE_USE_REMBG=1

# ADZMATE_USE_FIXTURE_METRICS=1
# Set to 0 in production when Meta Insights should drive strategy metrics.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://YOUR-API.onrender.com/api/meta/oauth/callback
