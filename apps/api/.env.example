# AdzMate API
# Copy to apps/api/.env

AUTH_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
PUBLIC_BASE_URL=http://localhost:8000

# --- AI agents (Gemini recommended) ---
ADZMATE_USE_LLM=1
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.0-flash

# --- Free AI image backgrounds for ads ---
ADZMATE_USE_AI_IMAGES=1
# Optional Hugging Face fallback: https://huggingface.co/settings/tokens
# HF_TOKEN=
# Optional better product cutouts: pip install rembg
# ADZMATE_USE_REMBG=1

# Optional: DistilBERT sentiment (pip install torch transformers)
# ADZMATE_USE_DISTILBERT=1

# --- Meta (Facebook / Instagram / Ads) OAuth ---
# Create an app at https://developers.facebook.com/ — add Facebook Login + Marketing API.
# Valid OAuth Redirect URI must match META_OAUTH_REDIRECT_URI exactly.
# Without these, the UI uses "Connect demo Meta" with mock Pages / IG / Ad Accounts.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:8000/api/meta/oauth/callback
# WEB_APP_URL=http://localhost:3000
