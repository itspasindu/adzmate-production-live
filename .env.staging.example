# Staging secrets — copy to the VPS as ~/adzmate/.env.staging
# Also used as a template for GitHub Environment secrets documentation.

# --- Images (set by deploy script; leave blank in secrets store) ---
# API_IMAGE=ghcr.io/ORG/adzmate-api:staging
# WEB_IMAGE=ghcr.io/ORG/adzmate-web:staging

API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Public URLs (replace with your VPS hostname or IP)
PUBLIC_BASE_URL=http://YOUR_STAGING_HOST:8000
WEB_APP_URL=http://YOUR_STAGING_HOST:3000
CORS_ORIGINS=["http://YOUR_STAGING_HOST:3000"]

# Auth
AUTH_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=

# AI (optional on staging)
ADZMATE_USE_LLM=0
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

ADZMATE_USE_AI_IMAGES=1

# Meta OAuth (optional)
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://YOUR_STAGING_HOST:8000/api/meta/oauth/callback
